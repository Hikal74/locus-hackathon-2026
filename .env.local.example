# Copy this file to .env.local (already gitignored) and fill in real values.
# .env.local is never committed — see docs/SECURITY.md.

# Custom OpenAI-compatible API (local proxy, LiteLLM, etc.). Takes priority
# over Groq and Anthropic when both base URL and key are set.
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
# Optional model name sent to your API. Defaults to "default".
CUSTOM_API_MODEL=

# Groq (recommended). Used for chat and explanation rephrasing when set.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=

# Anthropic (optional fallback). Used only when no higher-priority provider is set.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5. This feature is cheap/low-stakes
# rephrasing — claude-haiku-4-5 is a reasonable override if call volume makes
# cost a concern for you.
ANTHROPIC_MODEL=
