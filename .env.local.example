# Copy this file to .env.local (already gitignored) and fill in real values.
# .env.local is never committed — see docs/SECURITY.md.

# Required for the AI advisor and explanation layers (src/lib/ai/*). Without
# this, the app falls back to deterministic template copy automatically —
# nothing breaks. Get a key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here

# Optional. Defaults to gemini-3.6-flash — used for both the AI advisor's deep
# per-profile reasoning (src/lib/ai/advisor.ts) and the lighter explanation
# rephrasing (src/lib/ai/explain.ts). Leave blank to use the default (an empty
# value here is treated the same as unset). Override with a different model
# name if you want to trade off cost/latency/quality.
GEMINI_MODEL=
